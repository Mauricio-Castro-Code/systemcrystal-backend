# Copia este archivo a .env y rellena los valores

# Django
# Generar con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=tu-dominio.railway.app
DJANGO_CORS_ALLOWED_ORIGINS=https://tu-frontend.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://tu-frontend.vercel.app
# Railway se detecta automáticamente por RAILWAY_PROJECT_ID.
# En otros alojamientos, True solo con un proxy confiable que reescribe la cabecera.
# DJANGO_TRUST_PROXY_SSL_HEADER=True
DJANGO_SECURE_SSL_REDIRECT=True
# Número de proxies confiables delante del backend para identificar la IP en throttling.
DJANGO_NUM_PROXIES=0

# Base de datos (Supabase)
# Project Settings → Database → Connection string → URI → Session pooler
SUPABASE_DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Seguridad de registro
# Vacío deshabilita el registro. Solo permite crear usuarios de ventas.
# Crear el primer administrador con `python manage.py createsuperuser`.
REGISTRATION_ACCESS_KEY=

# PDF (opcional, solo si LibreOffice está instalado)
# LIBREOFFICE_BINARY=/usr/bin/libreoffice

# Optimización de ruta del chofer
OPENAI_API_KEY=sk-...
GOOGLE_MAPS_API_KEY=AIza...
DRIVER_ROUTE_START_ADDRESS=Bodega Crystal, Puebla, Pue.
# Se agrega a las direcciones de las notas si no la traen (mejora la geocodificación)
DRIVER_ROUTE_DEFAULT_LOCALITY=Puebla, Pue.
